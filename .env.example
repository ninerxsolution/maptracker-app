# Copy to `.env` and fill in. See docs/06-deployment.md for production notes.

# --- Database (PostgreSQL) ---
# Local dev: the Docker Postgres from docker-compose.yml (`docker compose up -d`).
DATABASE_URL="postgresql://maptracker:maptracker@localhost:5433/maptracker"
DATABASE_URL_UNPOOLED="postgresql://maptracker:maptracker@localhost:5433/maptracker"
# Production (Vercel): add Neon from the Vercel Storage tab — it injects both
# DATABASE_URL (pooled, used by the app) and DATABASE_URL_UNPOOLED (direct, used
# by `prisma migrate deploy`). Don't set them by hand there.

# --- Auth ---
# Secret used to sign session JWTs. REQUIRED. Generate: openssl rand -base64 48
# In production this must be >=32 chars and NOT a placeholder (enforced at runtime).
AUTH_SECRET="change-me-to-a-long-random-string"

# --- App ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Seed (optional) ---
# Override the seeded admin password (defaults to the demo password for local dev).
# Always set a strong value before seeding anything but a local database.
# SEED_ADMIN_PASSWORD="a-strong-unique-password"
